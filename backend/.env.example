# Copy to .env and fill in. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/pms

# Origin of the React app (used for links in emails; also the CORS default)
FRONTEND_URL=http://localhost:5173

# Browser origins allowed to call the API directly, with cookies (comma-separated, no trailing slash).
# Also used as CSRF_TRUSTED_ORIGINS unless that is set separately.
# Add the Vercel URL in production, e.g. https://pms.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Super Admin, ensured on every `migrate` (i.e. every server start on Render)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Super Admin

# Secret for /api/v1/jobs/run/?token=... (UptimeRobot)
JOBS_SECRET=change-me-too

# Email: Gmail SMTP in dev (use an App Password), Brevo SMTP in prod
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=PMS <you@gmail.com>
# Set to console to print emails to the terminal instead of sending
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Local demo accounts (python manage.py seed_demo). DEV ONLY.
DEMO_PASSWORD=change-me-demo1
