{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:mock",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8002",
        "--noreload"
      ],
      "port": 8002,
      "env": {
        "CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5177"
      },
      "autoPort": false
    },
    {
      "name": "frontend-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5177",
        "--strictPort"
      ],
      "port": 5177,
      "env": {
        "VITE_API_PROXY_TARGET": "http://127.0.0.1:8002"
      },
      "autoPort": false
    }
  ]
}
