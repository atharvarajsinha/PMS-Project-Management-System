# Used by `npm run build` (Vercel production builds). Committed on purpose: nothing here is secret,
# only VITE_* values reach the browser bundle.

# The browser calls the Render backend directly. The backend must run with COOKIE_SAMESITE=None
# and list the Vercel URL in CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS (see backend/.env.prod).
VITE_API_BASE_URL=https://pms-backend-rm42.onrender.com/api/v1
VITE_USE_MOCKS=false
