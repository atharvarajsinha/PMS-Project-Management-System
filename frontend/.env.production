# Used by `npm run build` (Vercel production builds). Committed on purpose: nothing here is secret,
# only VITE_* values reach the browser bundle.

# Keep it relative: vercel.json forwards /api/* to the Render backend, so the browser only ever
# talks to the Vercel domain and the auth cookies are first-party. Calling Render directly makes
# them third-party cookies, which incognito windows and Safari block (CSRF verification failed).
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=false
