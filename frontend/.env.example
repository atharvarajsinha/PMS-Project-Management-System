# Copy to .env (or .env.local for machine-specific overrides) and adjust.
# Only VITE_* variables are exposed to the browser bundle — never put secrets here.

# Base URL axios uses for every API call.
# Keep it relative so auth cookies are first-party (API.md §2): the Vite dev server
# proxies it to VITE_API_PROXY_TARGET, and vercel.json rewrites it in production.
# An absolute URL (e.g. http://127.0.0.1:8000/api/v1) only works if the backend adds
# CORS with credentials and cross-site cookies, which it doesn't today.
VITE_API_BASE_URL=/api/v1

# Where the dev server forwards /api (dev only, not used in builds).
# Use 127.0.0.1 rather than localhost: Node may resolve localhost to IPv6 (::1),
# while `manage.py runserver` listens on IPv4.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# true = serve the API from MSW in the browser (no backend). Set in .env.mock.
VITE_USE_MOCKS=false
