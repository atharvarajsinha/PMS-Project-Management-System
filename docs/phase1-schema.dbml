// PMS — Phase 1 schema (Platform Foundation) — DRAFT for approval
// Paste into dbdiagram.io to view. Phases, mentors and teams arrive in Phase 2 (see docs/roadmap.md).
// Tenancy: shared database, every tenant-owned row is scoped by college_id
// (directly or through its parent). Super Admin has college_id = NULL.

enum user_role {
	SUPER_ADMIN
	ADMIN
	FACULTY
	STUDENT
}

enum user_status {
	ACTIVE
	INACTIVE
}

enum college_status {
	ACTIVE
	INACTIVE
}

enum otp_purpose {
	PASSWORD_RESET
}

enum email_status {
	PENDING
	SENT
	FAILED
}

enum email_kind {
	ACCOUNT_ACTIVATION   // temp password generated at send time, never stored in plain text
	PASSWORD_RESET_OTP
	GENERIC
}

// ---------------------------------------------------------------- tenancy

Table colleges {
	id bigint [pk, increment]
	name varchar(255) [not null]
	code varchar(50) [not null, unique, note: 'short slug, e.g. SITARE']
	status college_status [not null, default: 'ACTIVE']
	contact_email varchar(255)
	contact_phone varchar(30)
	address text
	created_at timestamptz [not null]
	updated_at timestamptz [not null]
}

// ---------------------------------------------------------------- accounts

Table users {
	id bigint [pk, increment]
	college_id bigint [note: 'NULL only for SUPER_ADMIN (check constraint)']
	email varchar(255) [not null, unique, note: 'globally unique, case-insensitive; cannot be changed']
	password text [not null]
	role user_role [not null]
	status user_status [not null, default: 'INACTIVE']
	name varchar(255) [not null]
	phone varchar(30)
	must_change_password boolean [not null, default: true]
	activated_at timestamptz
	last_login_at timestamptz
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(college_id, role)
		(college_id) [unique, name: 'uq_one_admin_per_college', note: 'partial: WHERE role = ADMIN']
	}
}

Table faculty {
	id bigint [pk, increment]
	user_id bigint [not null, unique]
	college_id bigint [not null]
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(college_id)
	}
}

Table students {
	id bigint [pk, increment]
	user_id bigint [not null, unique]
	college_id bigint [not null]
	roll_number varchar(100) [not null]
	section_id bigint [not null]
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(college_id, roll_number) [unique, name: 'uq_roll_number_per_college']
		(section_id)
	}
}

Table password_reset_otps {
	id bigint [pk, increment]
	user_id bigint [not null]
	purpose otp_purpose [not null]
	otp_hash text [not null]
	expires_at timestamptz [not null]
	attempts integer [not null, default: 0]
	used_at timestamptz
	created_at timestamptz [not null]

	indexes {
		(user_id, purpose)
	}
}

// ---------------------------------------------------------------- academics

Table semesters {
	id bigint [pk, increment]
	college_id bigint [not null]
	semester_number integer [not null, note: 'check 1..12']
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(college_id, semester_number) [unique]
	}
}

Table subjects {
	id bigint [pk, increment]
	college_id bigint [not null]
	code varchar(50) [not null]
	name varchar(255) [not null]
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(college_id, code) [unique]
	}
}

Table sections {
	id bigint [pk, increment]
	semester_id bigint [not null]
	name varchar(100) [not null]
	class_teacher_id bigint
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(semester_id, name) [unique, name: 'uq_section_name_per_semester']
		(semester_id, class_teacher_id) [unique, name: 'uq_class_teacher_per_semester']
	}
}

Table semester_subjects {
	id bigint [pk, increment]
	semester_id bigint [not null]
	subject_id bigint [not null]
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(semester_id, subject_id) [unique]
		(subject_id)
	}
}

// section_subjects + section_subject_faculty merged (they were strictly 1:1).
// faculty_id is nullable so the mapping CSV can be imported before the faculty-assignment CSV.
Table section_subjects {
	id bigint [pk, increment]
	section_id bigint [not null]
	semester_subject_id bigint [not null, note: 'app-validated: same semester as section']
	faculty_id bigint
	faculty_assigned_at timestamptz
	created_at timestamptz [not null]
	updated_at timestamptz [not null]

	indexes {
		(section_id, semester_subject_id) [unique]
		(semester_subject_id)
		(faculty_id)
	}
}

// ---------------------------------------------------------------- college configuration

// One row per college, created together with the college. Edited by the College Admin.
// Team fields are configured in Phase 1 and enforced in Phase 2.
Table college_settings {
	id bigint [pk, increment]
	college_id bigint [not null, unique]
	min_team_size integer [not null, default: 2, note: 'check >= 2 (lead + at least one member)']
	max_team_size integer [not null, default: 4, note: 'check >= min_team_size']
	default_mentor_capacity integer [not null, default: 5, note: 'check > 0; per-faculty override comes in Phase 2']
	team_formation_enabled boolean [not null, default: false]
	teams_locked boolean [not null, default: false, note: 'global team lock']
	teams_locked_at timestamptz
	allow_cross_section_evaluation boolean [not null, default: false]
	updated_by bigint
	created_at timestamptz [not null]
	updated_at timestamptz [not null]
}

// ---------------------------------------------------------------- platform

Table audit_logs {
	id bigint [pk, increment]
	college_id bigint [note: 'NULL for platform-level actions']
	actor_id bigint
	actor_role user_role
	action varchar(100) [not null]
	entity_type varchar(100) [not null]
	entity_id bigint
	old_values jsonb
	new_values jsonb
	ip_address inet
	user_agent text
	created_at timestamptz [not null]

	indexes {
		(college_id, created_at)
		(actor_id)
		(entity_type, entity_id)
	}
}

// Drained by the UptimeRobot-triggered job endpoint.
Table email_outbox {
	id bigint [pk, increment]
	college_id bigint
	user_id bigint
	kind email_kind [not null]
	to_email varchar(255) [not null]
	subject varchar(255)
	body text
	context jsonb
	status email_status [not null, default: 'PENDING']
	attempts integer [not null, default: 0]
	last_error text
	created_at timestamptz [not null]
	sent_at timestamptz

	indexes {
		(status, created_at)
	}
}

// ---------------------------------------------------------------- relations
// (+ simplejwt token_blacklist tables, Django built-ins)

Ref: users.college_id > colleges.id [delete: cascade]
Ref: faculty.user_id - users.id [delete: cascade]
Ref: faculty.college_id > colleges.id [delete: cascade]
Ref: students.user_id - users.id [delete: cascade]
Ref: students.college_id > colleges.id [delete: cascade]
Ref: students.section_id > sections.id [delete: restrict]           // move/delete students first
Ref: password_reset_otps.user_id > users.id [delete: cascade]

Ref: semesters.college_id > colleges.id [delete: cascade]
Ref: subjects.college_id > colleges.id [delete: cascade]
Ref: sections.semester_id > semesters.id [delete: cascade]
Ref: sections.class_teacher_id > faculty.id [delete: set null]
Ref: semester_subjects.semester_id > semesters.id [delete: cascade]
Ref: semester_subjects.subject_id > subjects.id [delete: cascade]
Ref: section_subjects.section_id > sections.id [delete: cascade]
Ref: section_subjects.semester_subject_id > semester_subjects.id [delete: cascade]
Ref: section_subjects.faculty_id > faculty.id [delete: set null]
Ref: college_settings.college_id - colleges.id [delete: cascade]
Ref: college_settings.updated_by > users.id [delete: set null]

Ref: audit_logs.college_id > colleges.id [delete: cascade]
Ref: audit_logs.actor_id > users.id [delete: set null]
Ref: email_outbox.college_id > colleges.id [delete: cascade]
Ref: email_outbox.user_id > users.id [delete: cascade]
